{
  "name": "context-dashboard-template",
  "version": "0.1.0",
  "description": "Full-surface DeepSeek Harness context dashboard skeleton: Context tab, Fleet tab, /context command, right-sidebar panel, settings page, and demo data feed — modeled on the dsh-context plugin architecture as a no-build working template.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "tokens",
    "dashboard",
    "template"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "preview",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "react",
        "slots",
        "inputTriggers",
        "sidebarRightTabs"
      ]
    }
  },
  "license": "MIT"
}
